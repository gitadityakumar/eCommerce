{
  "name": "e-commerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "rm -rf .next && next dev",
    "sdev": "next dev --inspect",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check": "printf '\\033[36m\\nRunning lint...\\033[0m\\n' && pnpm run lint && printf '\\033[36m\\nRunning type check...\\033[0m\\n' && pnpm run type:check && printf '\\033[36m\\nChecking duplicate code with Fallow...\\033[0m\\n' && pnpm run fallow:dupes && printf '\\033[36m\\nChecking dead code with Fallow...\\033[0m\\n' && pnpm run fallow:dead-code && printf '\\033[32m\\nAll checks passed.\\033[32m\\n'",
    "fallow": "fallow",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:flags": "fallow flags",
    "type:check": "tsgo --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:seed:admin": "tsx src/lib/db/seed-admin.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.984.0",
    "@aws-sdk/s3-request-presigner": "^3.984.0",
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.1",
    "@react-pdf/renderer": "^4.3.2",
    "@tabler/icons-react": "^3.35.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.6.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.475.0",
    "next": "^16.1.7",
    "next-themes": "^0.4.6",
    "query-string": "^9.1.1",
    "react": "^19.2.0",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.68.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.3",
    "zeptomail": "^7.0.0",
    "zod": "^4.2.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@typescript/native-preview": "^7.0.0-dev.20260112.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "fallow": "^2.54.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "fallow",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "brace-expansion": ">=2.0.3",
      "defu": ">=6.1.7",
      "esbuild": ">=0.25.0",
      "fast-xml-parser": ">=5.5.7",
      "flatted": ">=3.4.2",
      "kysely": ">=0.28.16",
      "lodash": ">=4.18.1",
      "minimatch": ">=9.0.7",
      "picomatch": ">=4.0.4",
      "yaml": ">=2.8.3"
    }
  },
  "lint-staged": {
    "*": "pnpm run lint"
  }
}
